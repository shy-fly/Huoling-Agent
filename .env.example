# fireFairy 厌氧消化科研问答智能体 — 环境变量模板
# 复制为 `.env` 使用；真实密钥只放本机 `.env`，不得提交仓库、写入日志或展示材料。

# Database（本地 SQLite，无需独立数据库服务）
DATABASE_URL=sqlite:///./data/digester.db

# DeepSeek（OpenAI 兼容）。真实密钥绝不提交。
LLM_PROVIDER=deepseek
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_MS=60000
LLM_MAX_TOKENS_POLISH=2048
LLM_MAX_TOKENS_QA=4096
# DeepSeek V4 默认思考模式；关闭以把 token 预算留给正文
LLM_THINKING_ENABLED=false

# App
APP_ENV=production
APP_RELEASE=firefairy-contest-4.0.0
API_HOST=127.0.0.1
API_PORT=8001
FRONTEND_ORIGIN=http://localhost:5174
KNOWLEDGE_ROOT=knowledge

# 管理员写操作（知识库摄入、LLM 配置）使用长随机值
ADMIN_TOKEN=

# 检索
RAG_TOP_K=5
RAG_USE_VECTOR=true
USE_LLM=false

# Docker 首次启动是否自动全量 RAG 入库（知识库为空时）
DOCKER_SEED_KNOWLEDGE=true

# Docker 构建拉取基础镜像 / apt 失败时（国内网络可选镜像，能访问外网则留空即可）：
# DOCKER_REGISTRY_MIRROR=docker.m.daocloud.io/library/
# DOCKER_APT_MIRROR=mirrors.aliyun.com