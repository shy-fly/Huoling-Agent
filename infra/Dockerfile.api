ARG REGISTRY_MIRROR=
FROM ${REGISTRY_MIRROR}python:3.12-slim-bookworm

ARG APT_MIRROR=
WORKDIR /app

# PDF / docx / OCR（扫描版 PDF 上传）；默认 Debian 官方源；设 APT_MIRROR 时可替换 apt 镜像
RUN set -eu; \
    printf 'Acquire::Retries "5";\nAcquire::http::Timeout "120";\n' > /etc/apt/apt.conf.d/80-retries; \
    if [ -n "${APT_MIRROR:-}" ]; then \
      if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
        sed -i "s|deb.debian.org|${APT_MIRROR}|g; s|security.debian.org|${APT_MIRROR}|g" /etc/apt/sources.list.d/debian.sources; \
      elif [ -f /etc/apt/sources.list ]; then \
        sed -i "s|deb.debian.org|${APT_MIRROR}|g; s|security.debian.org|${APT_MIRROR}|g" /etc/apt/sources.list; \
      fi; \
    fi; \
    apt_install_core() { \
      apt-get update; \
      apt-get install -y --no-install-recommends libgomp1 tesseract-ocr tesseract-ocr-eng; \
    }; \
    n=0; max=5; \
    until apt_install_core; do \
      n=$((n + 1)); \
      if [ "$n" -ge "$max" ]; then echo "apt install failed after ${max} attempts"; exit 1; fi; \
      echo "apt install interrupted (network?), retry ${n}/${max}..."; \
      sleep 15; \
    done; \
    apt-get install -y --no-install-recommends tesseract-ocr-chi-sim || true; \
    rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
RUN pip install --no-cache-dir -e .

COPY app ./app
COPY scripts ./scripts
COPY data ./data

ENV PYTHONPATH=/app
ENV APP_ENV=production
ENV KNOWLEDGE_ROOT=/app/knowledge

EXPOSE 8000
ENTRYPOINT ["python3", "scripts/docker_entrypoint.py"]
